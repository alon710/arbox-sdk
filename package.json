{
  "name": "arbox-sdk",
  "version": "0.0.0-development",
  "description": "Unofficial, fully typed TypeScript client for the Arbox public API (v3). Zero dependencies.",
  "keywords": [
    "arbox",
    "arboxapp",
    "sdk",
    "api-client",
    "typescript",
    "gym",
    "fitness",
    "studio",
    "openapi"
  ],
  "license": "MIT",
  "author": "Alon Barad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alon710/arbox-sdk.git"
  },
  "homepage": "https://github.com/alon710/arbox-sdk#readme",
  "bugs": "https://github.com/alon710/arbox-sdk/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.12",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run package:check",
    "format": "biome format --write .",
    "generate": "bun scripts/generate.ts && biome format --write src/generated README.md",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "package:check": "publint --strict && attw --pack . --profile node16",
    "spec:fetch": "bun scripts/fetch-spec.ts",
    "test": "vitest run --project unit",
    "test:live": "vitest run --project live",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.7",
    "@semantic-release/exec": "^7.1.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "openapi-typescript": "^7.13.0",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.7",
    "typescript": "^6",
    "vitest": "^5.1.0"
  }
}
